{
  "name": "sawtak",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "electron": "node electron/launch.js",
    "electron:build": "next build && electron-builder --mac --dir",
    "electron:dist": "next build && electron-builder --mac",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.102.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "next": "^15.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.87.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "undici": "^8.11.0",
    "wavesurfer.js": "^7.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "prisma": "^6.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.7.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.ahmedhisham.sawtak",
    "productName": "Sawtak",
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "prisma",
        "to": "prisma",
        "filter": [
          "schema.prisma"
        ]
      },
      {
        "from": "tts-engine",
        "to": "tts-engine",
        "filter": [
          "**/*.py",
          "requirements.txt",
          "!venv/**"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist-electron"
    }
  },
  "description": "صوتك — Egyptian Arabic text-to-speech and voice cloning, running entirely on your own machine."
}
