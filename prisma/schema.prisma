generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite, not a server: the board is single-user and local, and dropping the
  // Postgres container frees the Docker Desktop VM (~2GB) for the 4B model.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model VoiceProfile {
  id                 String       @id @default(cuid())
  name               String
  description        String?  
  referenceAudioPath String
  referenceText      String       @default("")  // transcription of the reference clip — SILMA requires it to clone; empty means "needs filling in"
  duration           Float        // duration of reference audio in seconds
  isDefault          Boolean      @default(false)
  isBuiltin          Boolean      @default(false)  // shipped with the model (scripts/import_builtin_voices.py), not recorded by the user — sorts below their own voices
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  generations        Generation[]
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Generation {
  id              String           @id @default(cuid())
  text            String
  audioPath       String?
  savedPath       String?          // absolute path of the exported copy, when a custom save folder is used
  modelId         String           @default("silma")  // which engine rendered this (see tts-engine/model_registry.py)
  params          Json?            // the generation parameters actually used; names differ per model
  voiceProfileId  String?
  voiceProfile    VoiceProfile?    @relation(fields: [voiceProfileId], references: [id], onDelete: SetNull)
  // Legacy SILMA columns, kept so existing history keeps its detail. New rows
  // record their parameters in `params` instead, since each model has its own set.
  speed           Float            @default(1.0)
  cfgStrength     Float            @default(2.0)
  nfeStep         Int              @default(16)
  seed            String?                         // echoed back by the engine so a take can be reproduced (0..4294967295 overflows Int32, and BigInt will not JSON-serialize)
  duration        Float?           // duration of generated audio
  fileSize        Int?             // file size in bytes
  status          GenerationStatus @default(PENDING)
  error           String?
  createdAt       DateTime         @default(now())
  // Set when the clip is a segment of an episode. Studio clips leave both null.
  episodeId       String?
  episode         Episode?         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  // Slot in the episode's running order. Starts as creation order; a retake
  // renders into the same row so it keeps its slot, and moving swaps slots.
  position        Int?

  @@index([createdAt(sort: Desc)])
  @@index([voiceProfileId])
  @@index([status])
  @@index([episodeId, position])
}

/// A container for related audio — a channel, a series, a client. Holds any
/// number of episodes; it has no audio of its own.
model Project {
  id          String    @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  episodes    Episode[]

  @@index([updatedAt(sort: Desc)])
}

/// One finished piece of audio inside a project — a long episode, a short, an
/// ad read. Assembled from segments (Generation rows); merging joins their
/// audio, in `position` order, into one WAV.
model Episode {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  kind            String       @default("episode")  // episode | short | other — see EPISODE_KINDS in src/lib/projects.ts
  // The voice this episode renders with, so every segment sounds the same
  // across sessions. A new episode copies it from the project's most recently
  // edited episode.
  modelId         String?
  voiceProfileId  String?
  params          Json?
  outputDir       String?      // where the merged audio is exported; the segments stay in storage/audio
  gapMs           Int          @default(350)  // silence inserted between segments when merging
  // The latest merge. `mergedSignature` is the ordered list of segment ids and
  // audio paths it was built from; when the segments no longer produce the
  // same signature the merge is out of date.
  mergedAudioPath String?
  mergedSavedPath String?
  mergedDuration  Float?
  mergedAt        DateTime?
  mergedSignature String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  segments        Generation[]

  @@index([projectId, createdAt])
}

model Preset {
  id              String   @id @default(cuid())
  name            String
  description     String?
  modelId         String   @default("silma")  // presets are model-specific: the parameters do not transfer
  params          Json?
  // Legacy SILMA columns, kept for presets saved before multi-model support.
  speed           Float    @default(1.0)
  cfgStrength     Float    @default(2.0)
  nfeStep         Int      @default(16)
  voiceProfileId  String?
  createdAt       DateTime @default(now())

  // Scoped per model, not globally: the same name ("سريع", "محايد") is a
  // different parameter combination for each engine, and a global unique made
  // saving the second model's copy fail.
  @@unique([name, modelId])
}
